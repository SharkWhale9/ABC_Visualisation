async function runMcmcChain(seed) {
  const runToken = ++mcmcRunToken;
  const settings = readMcmcSettings();
  const cache = createMcmcCache(seed, settings);
  const rng = mulberry32(seed);
  const status = document.getElementById("mcmc-status");
  const statusText = document.getElementById("mcmc-status-text");

  mcmcCache = cache;
  setInferenceControlsDisabled(true);
  status.classList.remove("complete", "stale");
  status.classList.add("running");
  statusText.textContent = `Initializing ABC-MCMC from a prior draw with distance below ε = ${settings.epsilon.toFixed(3)}…`;
  document.getElementById("mcmc-summary-setting").textContent = summaryModeLabel(settings.summaryMode);
  document.getElementById("mcmc-epsilon-setting").textContent = settings.epsilon.toFixed(3);
  document.getElementById("mcmc-seed").textContent = String(seed >>> 0);
  document.getElementById("mcmc-runtime").textContent = "running";
  document.getElementById("mcmc-acceptance-rate").textContent = "—";
  document.getElementById("mcmc-accepted-moves").textContent = "finding a valid initial state";
  document.getElementById("mcmc-retained").textContent = "0";
  document.getElementById("mcmc-init-attempts").textContent = "0";
  document.getElementById("mcmc-posterior-mean").textContent = "β = — · γ = —";
  document.getElementById("mcmc-posterior-distance").textContent = "available after burn-in";

  await yieldToBrowser();
  const started = performance.now();

  try {
    const initial = await initializeMcmcState(cache, rng, runToken);
    if (!initial || runToken !== mcmcRunToken) return;

    cache.beta[0] = initial.beta;
    cache.gamma[0] = initial.gamma;
    cache.distance[0] = initial.distance;
    cache.completed = 0;
    await renderMcmc(cache);

    let currentBeta = initial.beta;
    let currentGamma = initial.gamma;
    let currentDistance = initial.distance;

    for (let iteration = 1; iteration <= MCMC_CONFIG.iterations; iteration += 1) {
      const proposedBeta = currentBeta + settings.sigmaBeta * sampleStandardNormal(rng);
      const proposedGamma = currentGamma + settings.sigmaGamma * sampleStandardNormal(rng);
      const inBounds = proposedBeta >= ABC_CONFIG.prior.betaMin
        && proposedBeta <= ABC_CONFIG.prior.betaMax
        && proposedGamma >= ABC_CONFIG.prior.gammaMin
        && proposedGamma <= ABC_CONFIG.prior.gammaMax;

      if (!inBounds) {
        cache.outOfBoundsProposals += 1;
      } else {
        cache.inBoundsSimulations += 1;
        const simulation = simulateStochasticSIR({
          beta: proposedBeta,
          gamma: proposedGamma,
          rng
        });
        const evaluated = simulationDistance(simulation, settings.summaryMode);

        // Uniform priors and a symmetric untruncated random-walk proposal make
        // the Metropolis-Hastings ratio one inside the prior support.
        if (evaluated.distance < settings.epsilon) {
          currentBeta = proposedBeta;
          currentGamma = proposedGamma;
          currentDistance = evaluated.distance;
          cache.accepted[iteration] = 1;
          cache.acceptedMoves += 1;
        }
      }

      // A rejected proposal copies the previous state exactly.
      cache.beta[iteration] = currentBeta;
      cache.gamma[iteration] = currentGamma;
      cache.distance[iteration] = currentDistance;
      cache.completed = iteration;

      if (iteration % MCMC_CONFIG.renderEvery === 0 || iteration === MCMC_CONFIG.iterations) {
        if (runToken !== mcmcRunToken) return;
        const rate = 100 * cache.acceptedMoves / iteration;
        statusText.textContent = `ABC-MCMC running… ${iteration.toLocaleString()} / ${MCMC_CONFIG.iterations.toLocaleString()} iterations; ${rate.toFixed(2)}% accepted moves.`;
        await renderMcmc(cache);
        await yieldToBrowser();
      }
    }

    cache.elapsedMs = performance.now() - started;
    cache.running = false;
    cache.stale = false;
    status.classList.remove("running", "stale");
    status.classList.add("complete");
    const rate = 100 * cache.acceptedMoves / MCMC_CONFIG.iterations;
    statusText.textContent = `ABC-MCMC complete: ${MCMC_CONFIG.iterations.toLocaleString()} iterations in ${cache.elapsedMs.toFixed(0)} ms, ${rate.toFixed(2)}% accepted moves, and ${(MCMC_CONFIG.iterations - MCMC_CONFIG.burnIn).toLocaleString()} retained states after burn-in.`;
    document.getElementById("mcmc-runtime").textContent = `${cache.elapsedMs.toFixed(0)} ms total`;
    await renderMcmc(cache);

    console.group("ABC-MCMC chain");
    console.table({
      seed: cache.seed,
      summaryMode: settings.summaryMode,
      epsilon: settings.epsilon,
      sigmaBeta: settings.sigmaBeta,
      sigmaGamma: settings.sigmaGamma,
      iterations: MCMC_CONFIG.iterations,
      burnIn: MCMC_CONFIG.burnIn,
      initializationAttempts: cache.initializationAttempts,
      acceptedMoves: cache.acceptedMoves,
      acceptanceRatePercent: rate,
      inBoundsSimulations: cache.inBoundsSimulations,
      outOfBoundsProposals: cache.outOfBoundsProposals,
      rejectionBackgroundPoints: cache.backgroundAccepted.length,
      elapsedMs: cache.elapsedMs,
      ...postBurnInSummary(cache)
    });
    console.groupEnd();
  } finally {
    if (runToken === mcmcRunToken) {
      cache.running = false;
      setInferenceControlsDisabled(false);
    }
  }
}

async function runAllInference(seed) {
  setInferenceControlsDisabled(true);
  try {
    // Cancel a prior chain before replacing its rejection-sampling background.
    mcmcRunToken += 1;
    await runRejectionBatch(seed);
    await runMcmcChain(deriveMcmcSeed(seed));
  } finally {
    setInferenceControlsDisabled(false);
  }
}

function handleInferenceError(error) {
  console.error(error);
  setInferenceControlsDisabled(false);
  const mcmcStatus = document.getElementById("mcmc-status");
  mcmcStatus.classList.remove("complete", "running");
  mcmcStatus.classList.add("stale");
  document.getElementById("mcmc-status-text").textContent = `Inference run failed: ${error.message}`;
  if (!rejectionCache) {
    document.getElementById("abc-status-text").textContent = `ABC batch failed: ${error.message}`;
  }
}

function bindMcmcControls() {
  const sigmaBeta = document.getElementById("sigma-beta-slider");
  const sigmaGamma = document.getElementById("sigma-gamma-slider");

  [sigmaBeta, sigmaGamma].forEach((slider) => {
    slider.addEventListener("input", () => {
      syncMcmcNextSettingsText();
      markMcmcStale();
    });
  });

  document.getElementById("run-mcmc").addEventListener("click", () => {
    runMcmcChain(deriveMcmcSeed(getSessionSeed())).catch(handleInferenceError);
  });

  syncMcmcNextSettingsText();
}

