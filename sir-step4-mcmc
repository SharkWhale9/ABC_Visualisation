  S: Object.freeze([995,994,992,985,982,974,963,952,938,922,901,874,841,791,734,691,650,603,539,481,428,373,326,276,238,200,177,155,131,116,100,90,77,72,63,57,52,46,43,41,40,39,39,35,33,32,31,29,27,27,27,27,26,26,25,24,24,23,22,22,22,22,22,22,22,22,22,22,21,21,21,21,21,21,21,21,21,21,21,21,21,21,21,21,21,21,21,20,20,20,20,20,20,20,20,20,20,20,20,20,20]),
  I: Object.freeze([5,6,8,15,18,24,32,41,51,63,77,98,120,161,200,229,251,268,303,331,356,377,397,404,410,409,397,385,376,359,329,306,284,258,241,218,202,188,171,159,151,133,121,114,105,97,87,80,71,63,56,54,48,42,39,37,36,36,35,32,25,22,20,17,17,15,14,13,14,13,12,12,10,8,7,7,7,6,4,4,4,4,4,4,4,4,3,4,4,4,3,3,3,3,2,2,2,1,1,1,1]),
  R: Object.freeze([0,0,0,0,0,2,5,7,11,15,22,28,39,48,66,80,99,129,158,188,216,250,277,320,352,391,426,460,493,525,571,604,639,670,696,725,746,766,786,800,809,828,840,851,862,871,882,891,902,910,917,919,926,932,936,939,940,941,943,946,953,956,958,961,961,963,964,965,965,966,967,967,969,971,972,972,972,973,975,975,975,975,975,975,975,975,976,976,976,976,977,977,977,977,978,978,978,979,979,979,979]),
