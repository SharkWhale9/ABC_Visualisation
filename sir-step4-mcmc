async function renderRejectionFromCache() {
  if (!rejectionCache) return;
  if (rejectionCache.distanceMode !== activeSummaryMode) {
    computeCachedDistances(rejectionCache, activeSummaryMode);
  }

  const accepted = acceptedProposalIndices(rejectionCache, activeEpsilon);
  const rate = 100 * accepted.length / ABC_CONFIG.proposals;
  document.getElementById("epsilon-value").textContent = activeEpsilon.toFixed(3);
  document.getElementById("abc-acceptance-rate").textContent = `${rate.toFixed(2)}%`;
  document.getElementById("abc-accepted-count").textContent = `${accepted.length.toLocaleString()} accepted of ${ABC_CONFIG.proposals.toLocaleString()}`;

  await Promise.all([
    renderRejectionScatter(rejectionCache, accepted),
    renderAcceptedCurves(rejectionCache, accepted)
  ]);
}

function scheduleRejectionRender() {
  if (rejectionRenderFrame !== null) cancelAnimationFrame(rejectionRenderFrame);
  rejectionRenderFrame = requestAnimationFrame(() => {
    rejectionRenderFrame = null;
    renderRejectionFromCache().catch((error) => console.error("ABC render failed", error));
  });
}

async function runRejectionBatch(seed) {
  const runToken = ++rejectionRunToken;
  const status = document.getElementById("abc-status");
  const statusText = document.getElementById("abc-status-text");
  const cache = createRejectionCache(seed);
  const rng = mulberry32(seed);
  const chunkSize = 200;

  status.classList.remove("complete");
  statusText.textContent = `Simulating ${ABC_CONFIG.proposals.toLocaleString()} prior proposals…`;
  document.getElementById("abc-seed").textContent = String(seed >>> 0);
  document.getElementById("abc-batch-time").textContent = "running";

  await new Promise((resolve) => requestAnimationFrame(resolve));
  const started = performance.now();

  for (let start = 0; start < ABC_CONFIG.proposals; start += chunkSize) {
    const stop = Math.min(start + chunkSize, ABC_CONFIG.proposals);
    for (let index = start; index < stop; index += 1) {
      const beta = uniformBetween(ABC_CONFIG.prior.betaMin, ABC_CONFIG.prior.betaMax, rng);
      const gamma = uniformBetween(ABC_CONFIG.prior.gammaMin, ABC_CONFIG.prior.gammaMax, rng);
      const simulation = simulateStochasticSIR({ beta, gamma, rng });
      cacheSimulation(cache, index, beta, gamma, simulation);
    }

    if (runToken !== rejectionRunToken) return;
    statusText.textContent = `Simulating prior proposals… ${stop.toLocaleString()} / ${ABC_CONFIG.proposals.toLocaleString()}`;
    await new Promise((resolve) => requestAnimationFrame(resolve));
  }

  cache.elapsedMs = performance.now() - started;
  computeCachedDistances(cache, activeSummaryMode);
  rejectionCache = cache;
  await renderRejectionFromCache();

  status.classList.add("complete");
  statusText.textContent = `Cached ${ABC_CONFIG.proposals.toLocaleString()} proposals and ${((cache.infectedCurves.byteLength + cache.beta.byteLength + cache.gamma.byteLength) / (1024 * 1024)).toFixed(2)} MB of trajectory/parameter data. Slider and summary changes now use this cache only.`;
  document.getElementById("abc-batch-time").textContent = `${cache.elapsedMs.toFixed(0)} ms to simulate`;

  console.group("Naive ABC rejection batch");
  console.table({
    seed: cache.seed,
    proposals: ABC_CONFIG.proposals,
    summaryMode: activeSummaryMode,
    epsilon: activeEpsilon,
    accepted: acceptedProposalIndices(cache, activeEpsilon).length,
    elapsedMs: cache.elapsedMs
  });
  console.groupEnd();
}

