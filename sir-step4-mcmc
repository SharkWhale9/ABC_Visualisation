function renderDiagnostics(results) {
  const body = document.getElementById("diagnostics-body");
  body.replaceChildren();

  results.forEach((result) => {
    const d = result.diagnostics;
    const structuralPass = d.maxPopulationError === 0
      && d.invalidStateCount === 0
      && d.monotonicityViolationCount === 0;

    const row = document.createElement("tr");
    row.innerHTML = `
      <td><strong>${result.label}</strong><br><span class="parameters">β=${result.beta.toFixed(2)}, γ=${result.gamma.toFixed(2)}</span></td>
      <td>${result.reproductionNumber.toFixed(1)}</td>
      <td><span class="pass">${structuralPass ? "PASS" : "CHECK"}</span><br><span class="parameters">ΔN max=${d.maxPopulationError}; invalid=${d.invalidStateCount}; monotonicity=${d.monotonicityViolationCount}</span></td>
      <td>${(100 * d.normalizedRmse).toFixed(3)}% of N</td>
      <td>${formatNumber(d.stochasticPeakHeight)} / ${formatNumber(d.deterministicPeakHeight)}</td>
      <td>${d.stochasticPeakDay} / ${d.deterministicPeakDay}</td>
      <td>${formatNumber(d.stochasticFinalSize)} / ${formatNumber(d.deterministicFinalSize)}</td>
    `;
    body.appendChild(row);
  });
}

