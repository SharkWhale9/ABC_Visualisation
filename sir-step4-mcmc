function uniformBetween(minimum, maximum, rng) {
  return minimum + (maximum - minimum) * rng();
}

function sampleStandardNormal(rng) {
  let u = 0;
  let v = 0;
  while (u === 0) u = rng();
  while (v === 0) v = rng();
  return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
}

function deriveMcmcSeed(baseSeed) {
  return ((baseSeed >>> 0) ^ MCMC_CONFIG.seedXor) >>> 0;
}

function normalizedSummaryDistance(peakHeight, peakDay, finalSize, mode) {
  const finalDifference = (finalSize - OBSERVED_SUMMARY.finalSize) / DEFAULTS.N;
  if (mode === "poor") return Math.abs(finalDifference);

  const peakDifference = (peakHeight - OBSERVED_SUMMARY.peakHeight) / DEFAULTS.N;
  const timingDifference = (peakDay - OBSERVED_SUMMARY.peakDay) / DEFAULTS.T;
  return Math.sqrt(
    peakDifference ** 2 + timingDifference ** 2 + finalDifference ** 2
  );
}

function simulationDistance(simulation, mode) {
  const summary = summarizeEpidemic(simulation);
  return {
    summary,
    distance: normalizedSummaryDistance(
      summary.peakHeight,
      summary.peakDay,
      summary.finalSize,
      mode
    )
  };
}

function yieldToBrowser() {
  return new Promise((resolve) => requestAnimationFrame(resolve));
}

function getSessionSeed() {
  try {
    const stored = Number.parseInt(sessionStorage.getItem(ABC_CONFIG.sessionSeedKey), 10);
    if (Number.isInteger(stored) && stored >= 0) return stored >>> 0;
    sessionStorage.setItem(ABC_CONFIG.sessionSeedKey, String(ABC_CONFIG.initialSeed));
  } catch (error) {
    console.warn("sessionStorage is unavailable; using the default ABC seed.", error);
  }
  return ABC_CONFIG.initialSeed >>> 0;
}

function createFreshSessionSeed() {
  const values = new Uint32Array(1);
  if (globalThis.crypto && typeof globalThis.crypto.getRandomValues === "function") {
    globalThis.crypto.getRandomValues(values);
  } else {
    values[0] = (Date.now() ^ Math.floor(Math.random() * 0xFFFFFFFF)) >>> 0;
  }
  const seed = values[0] >>> 0;
  try {
    sessionStorage.setItem(ABC_CONFIG.sessionSeedKey, String(seed));
  } catch (error) {
    console.warn("Could not store the new ABC seed in sessionStorage.", error);
  }
  return seed;
}

function createRejectionCache(seed) {
  const proposals = ABC_CONFIG.proposals;
  return {
    seed: seed >>> 0,
    beta: new Float64Array(proposals),
    gamma: new Float64Array(proposals),
    peakHeight: new Uint16Array(proposals),
    peakDay: new Uint8Array(proposals),
    finalSize: new Uint16Array(proposals),
    infectedCurves: new Uint16Array(proposals * (DEFAULTS.T + 1)),
    activeDistances: new Float64Array(proposals),
    distanceMode: null,
    elapsedMs: NaN
  };
}

function cacheSimulation(cache, index, beta, gamma, simulation) {
  const summary = summarizeEpidemic(simulation);
  cache.beta[index] = beta;
  cache.gamma[index] = gamma;
  cache.peakHeight[index] = summary.peakHeight;
  cache.peakDay[index] = summary.peakDay;
  cache.finalSize[index] = summary.finalSize;
  cache.infectedCurves.set(simulation.I, index * (DEFAULTS.T + 1));
}

function computeCachedDistances(cache, mode) {
  const distances = cache.activeDistances;

  for (let index = 0; index < ABC_CONFIG.proposals; index += 1) {
    distances[index] = normalizedSummaryDistance(
      cache.peakHeight[index],
      cache.peakDay[index],
      cache.finalSize[index],
      mode
    );
  }

  cache.distanceMode = mode;
  return distances;
}

function acceptedProposalIndices(cache, epsilon) {
  const accepted = [];
  for (let index = 0; index < ABC_CONFIG.proposals; index += 1) {
    if (cache.activeDistances[index] < epsilon) accepted.push(index);
  }
  return accepted;
}

function acceptedProposalIndicesForSettings(cache, mode, epsilon) {
  const accepted = [];
  for (let index = 0; index < ABC_CONFIG.proposals; index += 1) {
    const distance = normalizedSummaryDistance(
      cache.peakHeight[index],
      cache.peakDay[index],
      cache.finalSize[index],
      mode
    );
    if (distance < epsilon) accepted.push(index);
  }
  return accepted;
}

function cachedInfectedCurve(cache, proposalIndex) {
  const width = DEFAULTS.T + 1;
  const start = proposalIndex * width;
  return cache.infectedCurves.slice(start, start + width);
}

function selectClosestAccepted(cache, accepted, count = ABC_CONFIG.curveCount) {
  return accepted
    .slice()
    .sort((left, right) => cache.activeDistances[left] - cache.activeDistances[right])
    .slice(0, count);
}

