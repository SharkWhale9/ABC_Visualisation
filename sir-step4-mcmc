    renderMcmcTraces
  ].map((item) => typeof item === "function" ? item.toString() : item).join("\n\n");
}

async function runValidation() {
  const status = document.getElementById("status");
  const statusText = document.getElementById("status-text");
  const rerunButton = document.getElementById("rerun");

  status.classList.remove("complete");
  statusText.textContent = `Running ${VALIDATION_SCENARIOS.length * VALIDATION_REPLICATES.toLocaleString()} stochastic simulations…`;
  rerunButton.disabled = true;
  buildScenarioCards();

  await new Promise((resolve) => requestAnimationFrame(() => setTimeout(resolve, 20)));
  const started = performance.now();
  const results = VALIDATION_SCENARIOS.map((scenario) => validateScenario(scenario, VALIDATION_REPLICATES));
  renderDiagnostics(results);

  if (typeof Plotly === "undefined") {
    statusText.textContent = "Numerical validation completed, but Plotly.js did not load. Check the network connection used for the CDN.";
    rerunButton.disabled = false;
    return;
  }

  await Promise.all([renderObservedEpidemic(), ...results.map(renderPlot)]);
  const elapsed = performance.now() - started;
  status.classList.add("complete");
  statusText.textContent = `Validation complete: ${results.length * VALIDATION_REPLICATES.toLocaleString()} simulations in ${elapsed.toFixed(0)} ms. All structural checks passed.`;
  rerunButton.disabled = false;

  console.group("Stochastic SIR validation");
  console.table(results.map((result) => ({
    regime: result.label,
    beta: result.beta,
    gamma: result.gamma,
    R0: result.reproductionNumber,
    maxPopulationError: result.diagnostics.maxPopulationError,
    invalidStates: result.diagnostics.invalidStateCount,
    monotonicityViolations: result.diagnostics.monotonicityViolationCount,
    infectedNRMSEPercentOfN: 100 * result.diagnostics.normalizedRmse,
    meanPeakDay: result.diagnostics.stochasticPeakDay,
    odePeakDay: result.diagnostics.deterministicPeakDay,
    meanFinalSize: result.diagnostics.stochasticFinalSize,
    odeFinalSize: result.diagnostics.deterministicFinalSize
  })));
  console.groupEnd();
}

showExecutedCode();
bindRejectionControls();
bindMcmcControls();
renderObservedEpidemic().catch((error) => console.error("Observed-data rendering failed", error));
document.getElementById("rerun").addEventListener("click", runValidation);
runValidation().catch((error) => {
  console.error(error);
  const statusText = document.getElementById("status-text");
  statusText.textContent = `Validation failed: ${error.message}`;
  document.getElementById("rerun").disabled = false;
});
runAllInference(getSessionSeed()).catch(handleInferenceError);
  </script>
</body>
