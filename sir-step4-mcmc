function readMcmcSettings() {
  return {
    summaryMode: activeSummaryMode,
    epsilon: activeEpsilon,
    sigmaBeta: Number(document.getElementById("sigma-beta-slider").value),
    sigmaGamma: Number(document.getElementById("sigma-gamma-slider").value)
  };
}

function summaryModeLabel(mode) {
  return mode === "poor" ? "Poor: final only" : "Rich: peak, day, final";
}

function setInferenceControlsDisabled(disabled) {
  document.getElementById("resimulate-abc").disabled = disabled;
  document.getElementById("run-mcmc").disabled = disabled;
}

function syncMcmcNextSettingsText() {
  const settings = readMcmcSettings();
  document.getElementById("sigma-beta-value").textContent = settings.sigmaBeta.toFixed(3);
  document.getElementById("sigma-gamma-value").textContent = settings.sigmaGamma.toFixed(3);
  document.getElementById("mcmc-config-note").textContent =
    `Next run: ${settings.summaryMode === "poor" ? "Poor" : "Rich"} summary, ε = ${settings.epsilon.toFixed(3)}, σβ = ${settings.sigmaBeta.toFixed(3)}, σγ = ${settings.sigmaGamma.toFixed(3)}.`;
}

function mcmcSettingsDiffer(left, right) {
  if (!left || !right) return true;
  return left.summaryMode !== right.summaryMode
    || Math.abs(left.epsilon - right.epsilon) > 1e-12
    || Math.abs(left.sigmaBeta - right.sigmaBeta) > 1e-12
    || Math.abs(left.sigmaGamma - right.sigmaGamma) > 1e-12;
}

function markMcmcStale() {
  if (!mcmcCache || mcmcCache.running) return;
  const nextSettings = readMcmcSettings();
  const status = document.getElementById("mcmc-status");
  const statusText = document.getElementById("mcmc-status-text");

  if (!mcmcSettingsDiffer(mcmcCache.settings, nextSettings)) {
    if (mcmcCache.stale && mcmcCache.completed === MCMC_CONFIG.iterations) {
      mcmcCache.stale = false;
      status.classList.remove("stale", "running");
      status.classList.add("complete");
      const rate = 100 * mcmcCache.acceptedMoves / MCMC_CONFIG.iterations;
      statusText.textContent = `ABC-MCMC complete: ${MCMC_CONFIG.iterations.toLocaleString()} iterations in ${mcmcCache.elapsedMs.toFixed(0)} ms, ${rate.toFixed(2)}% accepted moves, and ${(MCMC_CONFIG.iterations - MCMC_CONFIG.burnIn).toLocaleString()} retained states after burn-in.`;
    }
    return;
  }

  mcmcCache.stale = true;
  status.classList.remove("complete", "running");
  status.classList.add("stale");
  statusText.textContent =
    `The plotted chain remains the valid result for ${summaryModeLabel(mcmcCache.settings.summaryMode)}, ε = ${mcmcCache.settings.epsilon.toFixed(3)}, σβ = ${mcmcCache.settings.sigmaBeta.toFixed(3)}, σγ = ${mcmcCache.settings.sigmaGamma.toFixed(3)}. Run the chain to apply the pending controls.`;
}

function createMcmcCache(seed, settings) {
  const length = MCMC_CONFIG.iterations + 1;
  const backgroundAccepted = rejectionCache
    ? acceptedProposalIndicesForSettings(rejectionCache, settings.summaryMode, settings.epsilon)
    : [];

  return {
    seed: seed >>> 0,
    settings: Object.freeze({ ...settings }),
    beta: new Float64Array(length),
    gamma: new Float64Array(length),
    distance: new Float64Array(length),
    accepted: new Uint8Array(length),
    completed: 0,
    acceptedMoves: 0,
    inBoundsSimulations: 0,
    outOfBoundsProposals: 0,
    initializationAttempts: 0,
    elapsedMs: NaN,
    running: true,
    stale: false,
    backgroundAccepted
  };
}

async function initializeMcmcState(cache, rng, runToken) {
  const statusText = document.getElementById("mcmc-status-text");
  let closestDistance = Infinity;

  for (let attempt = 1; attempt <= MCMC_CONFIG.maxInitializationAttempts; attempt += 1) {
    const beta = uniformBetween(ABC_CONFIG.prior.betaMin, ABC_CONFIG.prior.betaMax, rng);
    const gamma = uniformBetween(ABC_CONFIG.prior.gammaMin, ABC_CONFIG.prior.gammaMax, rng);
    const simulation = simulateStochasticSIR({ beta, gamma, rng });
    const evaluated = simulationDistance(simulation, cache.settings.summaryMode);
    cache.initializationAttempts = attempt;
    closestDistance = Math.min(closestDistance, evaluated.distance);

    if (evaluated.distance < cache.settings.epsilon) {
      return { beta, gamma, distance: evaluated.distance };
    }

    if (attempt % 250 === 0) {
      if (runToken !== mcmcRunToken) return null;
      statusText.textContent = `Searching the prior for a valid initial state… ${attempt.toLocaleString()} draws; closest distance ${closestDistance.toFixed(4)}.`;
      document.getElementById("mcmc-init-attempts").textContent = attempt.toLocaleString();
      await yieldToBrowser();
    }
  }

  throw new Error(
    `No initial prior draw passed ε = ${cache.settings.epsilon.toFixed(3)} after ${MCMC_CONFIG.maxInitializationAttempts.toLocaleString()} attempts. Increase ε before rerunning the chain.`
  );
}

function postBurnInSummary(cache, upto = cache.completed) {
  const first = MCMC_CONFIG.burnIn + 1;
  if (upto < first) return null;

  let betaTotal = 0;
  let gammaTotal = 0;
  let distanceTotal = 0;
  let count = 0;
  for (let index = first; index <= upto; index += 1) {
    betaTotal += cache.beta[index];
    gammaTotal += cache.gamma[index];
    distanceTotal += cache.distance[index];
    count += 1;
  }

  return {
    count,
    meanBeta: betaTotal / count,
    meanGamma: gammaTotal / count,
    meanDistance: distanceTotal / count
  };
}

function updateMcmcMetrics(cache) {
  const completed = cache.completed;
  const rate = completed > 0 ? 100 * cache.acceptedMoves / completed : 0;
  const retained = Math.max(0, completed - MCMC_CONFIG.burnIn);
  const summary = postBurnInSummary(cache, completed);

  document.getElementById("mcmc-acceptance-rate").textContent = completed > 0 ? `${rate.toFixed(2)}%` : "—";
  document.getElementById("mcmc-accepted-moves").textContent = completed > 0
    ? `${cache.acceptedMoves.toLocaleString()} accepted moves of ${completed.toLocaleString()}`
    : "initial state only";
  document.getElementById("mcmc-retained").textContent = retained.toLocaleString();
  document.getElementById("mcmc-init-attempts").textContent = cache.initializationAttempts.toLocaleString();
  document.getElementById("mcmc-seed").textContent = String(cache.seed);

  if (summary) {
    document.getElementById("mcmc-posterior-mean").textContent =
      `β = ${summary.meanBeta.toFixed(3)} · γ = ${summary.meanGamma.toFixed(3)}`;
    document.getElementById("mcmc-posterior-distance").textContent =
      `${summary.count.toLocaleString()} retained states · mean distance ${summary.meanDistance.toFixed(4)}`;
  } else {
    document.getElementById("mcmc-posterior-mean").textContent = "β = — · γ = —";
    document.getElementById("mcmc-posterior-distance").textContent =
      `${retained.toLocaleString()} retained states available so far`;
  }
}

function sliceTyped(values, start, stopInclusive) {
  if (stopInclusive < start) return [];
  return Array.from(values.slice(start, stopInclusive + 1));
}

function pathCustomData(cache, start, stopInclusive) {
  const values = [];
  for (let index = start; index <= stopInclusive; index += 1) {
    values.push([index, cache.distance[index]]);
  }
  return values;
}

function renderMcmcPath(cache) {
  if (typeof Plotly === "undefined") return Promise.resolve();

  const upto = cache.completed;
  const burnEnd = Math.min(upto, MCMC_CONFIG.burnIn);
  const samplingStart = Math.min(MCMC_CONFIG.burnIn, upto);
  const backgroundBeta = cache.backgroundAccepted.map((index) => rejectionCache.beta[index]);
  const backgroundGamma = cache.backgroundAccepted.map((index) => rejectionCache.gamma[index]);

  const traces = [
    {
      x: backgroundBeta,
      y: backgroundGamma,
      mode: "markers",
      marker: { color: "rgba(40, 95, 143, 0.16)", size: 6 },
      name: `Panel 1 accepted (${backgroundBeta.length.toLocaleString()})`,
      hovertemplate: "β=%{x:.3f}<br>γ=%{y:.3f}<extra>Rejection sample</extra>"
    },
    {
      x: sliceTyped(cache.beta, 0, burnEnd),
      y: sliceTyped(cache.gamma, 0, burnEnd),
      customdata: pathCustomData(cache, 0, burnEnd),
      mode: "lines+markers",
      line: { color: "#9a6a1c", width: 1.6 },
