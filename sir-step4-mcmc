/** Deterministic, seedable PRNG for reproducible browser simulations. */
function mulberry32(seed) {
  let state = seed >>> 0;
  return function random() {
    state = (state + 0x6D2B79F5) | 0;
    let value = Math.imul(state ^ (state >>> 15), 1 | state);
    value ^= value + Math.imul(value ^ (value >>> 7), 61 | value);
    return ((value ^ (value >>> 14)) >>> 0) / 4294967296;
  };
}

/** Natural log of Gamma(z), using the Lanczos approximation. */
function logGamma(z) {
  const coefficients = [
    0.99999999999980993,
    676.5203681218851,
    -1259.1392167224028,
    771.32342877765313,
    -176.61502916214059,
    12.507343278686905,
    -0.13857109526572012,
    9.9843695780195716e-6,
    1.5056327351493116e-7
  ];
  const g = 7;

  if (z < 0.5) {
    return Math.log(Math.PI) - Math.log(Math.sin(Math.PI * z)) - logGamma(1 - z);
  }

  const shifted = z - 1;
  let series = coefficients[0];
  for (let i = 1; i < coefficients.length; i += 1) {
    series += coefficients[i] / (shifted + i);
  }
  const t = shifted + g + 0.5;
  return 0.5 * Math.log(2 * Math.PI)
    + (shifted + 0.5) * Math.log(t)
    - t
    + Math.log(series);
}

/**
 * Draw X ~ Binomial(n, p) without a statistics library.
 *
 * For small n*p, inverse-CDF recursion is efficient. For larger n*p,
 * tangent-envelope rejection sampling avoids n Bernoulli draws. Values
 * p > 0.5 use symmetry: Bin(n,p) = n - Bin(n,1-p).
 */
function sampleBinomial(n, p, rng) {
  if (!Number.isInteger(n) || n < 0) {
    throw new RangeError("n must be a non-negative integer.");
  }
  if (!Number.isFinite(p) || p < 0 || p > 1) {
    throw new RangeError("p must lie in [0, 1].");
  }
  if (n === 0 || p === 0) return 0;
  if (p === 1) return n;

  let probability = p;
  let reflect = false;
  if (probability > 0.5) {
    probability = 1 - probability;
    reflect = true;
  }

  const q = 1 - probability;
  const mean = n * probability;
  let draw;

  if (mean < 30) {
    const odds = probability / q;
    let mass = Math.exp(n * Math.log(q));
    let cumulative = mass;
    const u = rng();
    draw = 0;

    while (u > cumulative && draw < n) {
      draw += 1;
      mass *= ((n - draw + 1) / draw) * odds;
      cumulative += mass;
    }
  } else {
    const scale = Math.sqrt(2 * mean * q);
    const logP = Math.log(probability);
    const logQ = Math.log(q);

    for (;;) {
      let y;
      let proposal;
      do {
        y = Math.tan(Math.PI * rng());
        proposal = scale * y + mean;
      } while (proposal < 0 || proposal >= n + 1);

      draw = Math.floor(proposal);
      const logMass = logGamma(n + 1)
        - logGamma(draw + 1)
        - logGamma(n - draw + 1)
        + draw * logP
        + (n - draw) * logQ;
      const acceptanceBound = 1.2 * scale * (1 + y * y) * Math.exp(logMass);

      if (rng() <= acceptanceBound) break;
    }
  }

  return reflect ? n - draw : draw;
}

/**
 * Simulate the discrete-time stochastic SIR model for T days.
 * New infections and recoveries are sampled from start-of-day counts.
 */
function simulateStochasticSIR({
  beta,
  gamma,
  N = DEFAULTS.N,
  I0 = DEFAULTS.I0,
  R0 = DEFAULTS.R0,
  T = DEFAULTS.T,
  dt = DEFAULTS.dt,
  rng = Math.random
}) {
  if (!(beta >= 0) || !(gamma >= 0)) {
    throw new RangeError("beta and gamma must be non-negative.");
  }
  if (!Number.isInteger(N) || !Number.isInteger(I0) || !Number.isInteger(R0)) {
    throw new TypeError("N, I0, and R0 must be integers.");
  }
  if (I0 < 0 || R0 < 0 || I0 + R0 > N) {
    throw new RangeError("Initial compartment counts are invalid.");
  }
  if (!Number.isInteger(T) || T < 0 || !(dt > 0)) {
    throw new RangeError("T must be a non-negative integer and dt must be positive.");
  }

  const S = new Int32Array(T + 1);
  const I = new Int32Array(T + 1);
  const R = new Int32Array(T + 1);
  const newInfections = new Int32Array(T);
  const newRecoveries = new Int32Array(T);

  S[0] = N - I0 - R0;
  I[0] = I0;
  R[0] = R0;

  const recoveryProbability = 1 - Math.exp(-gamma * dt);

  for (let day = 0; day < T; day += 1) {
    const infectionProbability = 1 - Math.exp(-beta * I[day] / N * dt);
    const infections = sampleBinomial(S[day], infectionProbability, rng);
    const recoveries = sampleBinomial(I[day], recoveryProbability, rng);

    newInfections[day] = infections;
    newRecoveries[day] = recoveries;
    S[day + 1] = S[day] - infections;
    I[day + 1] = I[day] + infections - recoveries;
    R[day + 1] = R[day] + recoveries;
  }

  return { S, I, R, newInfections, newRecoveries };
}

function sirDerivative(state, beta, gamma, N) {
  const [S, I] = state;
  const incidence = beta * S * I / N;
  return [-incidence, incidence - gamma * I, gamma * I];
}

function rk4Step(state, h, beta, gamma, N) {
  const k1 = sirDerivative(state, beta, gamma, N);
  const k2 = sirDerivative(state.map((value, index) => value + 0.5 * h * k1[index]), beta, gamma, N);
  const k3 = sirDerivative(state.map((value, index) => value + 0.5 * h * k2[index]), beta, gamma, N);
  const k4 = sirDerivative(state.map((value, index) => value + h * k3[index]), beta, gamma, N);

  return state.map((value, index) => value + h * (
    k1[index] + 2 * k2[index] + 2 * k3[index] + k4[index]
  ) / 6);
}

/** Solve the reference deterministic SIR ODE with RK4 and return daily values. */
function simulateDeterministicSIR({
  beta,
  gamma,
  N = DEFAULTS.N,
  I0 = DEFAULTS.I0,
  R0 = DEFAULTS.R0,
  T = DEFAULTS.T,
  internalDt = 0.05
}) {
  if (!(internalDt > 0) || Math.abs(1 / internalDt - Math.round(1 / internalDt)) > 1e-10) {
    throw new RangeError("internalDt must divide one day exactly.");
  }

  const S = new Float64Array(T + 1);
  const I = new Float64Array(T + 1);
  const R = new Float64Array(T + 1);
  S[0] = N - I0 - R0;
  I[0] = I0;
  R[0] = R0;

  const substepsPerDay = Math.round(1 / internalDt);
  let state = [S[0], I[0], R[0]];

  for (let day = 1; day <= T; day += 1) {
    for (let substep = 0; substep < substepsPerDay; substep += 1) {
      state = rk4Step(state, internalDt, beta, gamma, N);
    }
    [S[day], I[day], R[day]] = state;
  }

  return { S, I, R };
}

function typedArrayToArray(values) {
  return Array.from(values);
}

function indexOfMaximum(values) {
  let bestIndex = 0;
  for (let i = 1; i < values.length; i += 1) {
    if (values[i] > values[bestIndex]) bestIndex = i;
  }
  return bestIndex;
}


function summarizeEpidemic(epidemic) {
  const peakDay = indexOfMaximum(epidemic.I);
  const peakHeight = epidemic.I[peakDay];
  const finalSize = DEFAULTS.N - epidemic.S[DEFAULTS.T];

  return Object.freeze({
    peakHeight,
    peakDay,
    finalSize,
    rich: Object.freeze([peakHeight, peakDay, finalSize]),
    poor: Object.freeze([finalSize])
  });
}

function verifyFixedObservedEpidemic(epidemic) {
  const expectedStateLength = DEFAULTS.T + 1;
  if (epidemic.S.length !== expectedStateLength
      || epidemic.I.length !== expectedStateLength
      || epidemic.R.length !== expectedStateLength
      || epidemic.newInfections.length !== DEFAULTS.T
      || epidemic.newRecoveries.length !== DEFAULTS.T) {
    throw new Error("Fixed observed arrays have the wrong length.");
  }

  for (let day = 0; day <= DEFAULTS.T; day += 1) {
    if (epidemic.S[day] + epidemic.I[day] + epidemic.R[day] !== DEFAULTS.N) {
      throw new Error(`Observed population is not conserved on day ${day}.`);
    }
    if (epidemic.S[day] < 0 || epidemic.I[day] < 0 || epidemic.R[day] < 0) {
      throw new Error(`Observed curve contains a negative compartment on day ${day}.`);
    }

    if (day < DEFAULTS.T) {
      const infections = epidemic.newInfections[day];
      const recoveries = epidemic.newRecoveries[day];
      if (epidemic.S[day + 1] !== epidemic.S[day] - infections
          || epidemic.I[day + 1] !== epidemic.I[day] + infections - recoveries
          || epidemic.R[day + 1] !== epidemic.R[day] + recoveries) {
        throw new Error(`Observed transitions are inconsistent on day ${day}.`);
      }
    }
  }
  return true;
}

function quantile(sortedValues, probability) {
  if (sortedValues.length === 0) return NaN;
  const position = (sortedValues.length - 1) * probability;
  const lower = Math.floor(position);
  const upper = Math.ceil(position);
  const weight = position - lower;
  return sortedValues[lower] * (1 - weight) + sortedValues[upper] * weight;
}

function validateScenario({ beta, gamma, label, seed }, replicates = 500) {
  const deterministic = simulateDeterministicSIR({ beta, gamma });
  const meanS = new Float64Array(DEFAULTS.T + 1);
  const meanI = new Float64Array(DEFAULTS.T + 1);
  const meanR = new Float64Array(DEFAULTS.T + 1);
  const infectedByDay = Array.from({ length: DEFAULTS.T + 1 }, () => new Float64Array(replicates));

  let example = null;
  let maxPopulationError = 0;
  let invalidStateCount = 0;
  let monotonicityViolationCount = 0;

  const rng = mulberry32(seed);
  for (let run = 0; run < replicates; run += 1) {
    const simulation = simulateStochasticSIR({ beta, gamma, rng });
    if (run === 0) example = simulation;

    for (let day = 0; day <= DEFAULTS.T; day += 1) {
      const s = simulation.S[day];
      const i = simulation.I[day];
      const r = simulation.R[day];
      meanS[day] += s / replicates;
      meanI[day] += i / replicates;
      meanR[day] += r / replicates;
      infectedByDay[day][run] = i;

      maxPopulationError = Math.max(maxPopulationError, Math.abs(s + i + r - DEFAULTS.N));
      if (!Number.isInteger(s) || !Number.isInteger(i) || !Number.isInteger(r)
          || s < 0 || i < 0 || r < 0) {
        invalidStateCount += 1;
      }
      if (day > 0 && (s > simulation.S[day - 1] || r < simulation.R[day - 1])) {
        monotonicityViolationCount += 1;
      }
    }
  }

  const lowerI = new Float64Array(DEFAULTS.T + 1);
  const upperI = new Float64Array(DEFAULTS.T + 1);
  for (let day = 0; day <= DEFAULTS.T; day += 1) {
    const sorted = Array.from(infectedByDay[day]).sort((a, b) => a - b);
    lowerI[day] = quantile(sorted, 0.1);
    upperI[day] = quantile(sorted, 0.9);
  }

  let squaredError = 0;
  for (let day = 0; day <= DEFAULTS.T; day += 1) {
    squaredError += (meanI[day] - deterministic.I[day]) ** 2;
  }
  const normalizedRmse = Math.sqrt(squaredError / (DEFAULTS.T + 1)) / DEFAULTS.N;
  const stochasticPeakDay = indexOfMaximum(meanI);
  const deterministicPeakDay = indexOfMaximum(deterministic.I);

  return {
    label,
    beta,
    gamma,
    reproductionNumber: beta / gamma,
    replicates,
    deterministic,
    example,
    meanS,
    meanI,
    meanR,
    lowerI,
    upperI,
    diagnostics: {
      maxPopulationError,
      invalidStateCount,
      monotonicityViolationCount,
      normalizedRmse,
      stochasticPeakDay,
      stochasticPeakHeight: meanI[stochasticPeakDay],
      deterministicPeakDay,
      deterministicPeakHeight: deterministic.I[deterministicPeakDay],
      stochasticFinalSize: DEFAULTS.N - meanS[DEFAULTS.T],
      deterministicFinalSize: DEFAULTS.N - deterministic.S[DEFAULTS.T]
    }
  };
}

if (typeof module !== "undefined" && module.exports) {
  module.exports = {
    DEFAULTS,
    mulberry32,
    logGamma,
    sampleBinomial,
    simulateStochasticSIR,
    simulateDeterministicSIR,
    validateScenario,
    typedArrayToArray
  };
}

